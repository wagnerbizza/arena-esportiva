    && d.at == resource.data.at && d.actor == resource.data.actor
    && d.home == resource.data.home && d.away == resource.data.away && d.sport == resource.data.sport
    && d.competition == resource.data.competition && d.status == resource.data.status && d.score == resource.data.score
    && d.purgeReason == resource.data.purgeReason
    && d.purgeStartedBy == resource.data.purgeStartedBy && d.purgeStartedAt == resource.data.purgeStartedAt
    && d.purgedBy == request.auth.uid && d.purgedAt == request.time;
  }
  match /cleanupAudit/{id} {
   allow read: if owner();
   allow create: if owner() && cleanupAuditBase(request.resource.data,id)
    && exists(/databases/$(database)/documents/matches/$(id))
    && request.resource.data.state == 'lixeira' && request.resource.data.before == get(/databases/$(database)/documents/matches/$(id)).data
    && request.resource.data.after == null && request.resource.data.at == request.time
    && request.resource.data.actor == request.auth.uid && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && request.resource.data.home == get(/databases/$(database)/documents/matches/$(id)).data.home
    && request.resource.data.away == get(/databases/$(database)/documents/matches/$(id)).data.away
    && request.resource.data.sport == get(/databases/$(database)/documents/matches/$(id)).data.sport
    && request.resource.data.competition == get(/databases/$(database)/documents/matches/$(id)).data.competition
    && request.resource.data.status == get(/databases/$(database)/documents/matches/$(id)).data.status
    && request.resource.data.score == get(/databases/$(database)/documents/matches/$(id)).data.score
    && cleanupAllowed(id,get(/databases/$(database)/documents/matches/$(id)).data);
   allow update: if restoreCleanupRecord(id) || startCleanupPurge(id) || finishCleanupPurge(id);
   allow delete: if false;
  }
  match /matches/{id} {
   allow get: if operatorFor(id) || (matchCreator() && !exists(/databases/$(database)/documents/matches/$(id)));
   allow list: if admin() || (resource.data.testData == false && championshipOperator(resource.data.get('championshipId','')));
  allow create: if (sportsAvailable() && activeSports(request.resource.data) && activeRef('teams',request.resource.data.home) && activeRef('teams',request.resource.data.away) && (request.resource.data.get('championshipId','') == '' || activeRef('championships',request.resource.data.championshipId)) && matchCreator() && matchSchema(request.resource.data,id) && request.resource.data._revision == 1
   && exists(/databases/$(database)/documents/teams/$(request.resource.data.home)) && exists(/databases/$(database)/documents/teams/$(request.resource.data.away))
   && get(/databases/$(database)/documents/teams/$(request.resource.data.home)).data.get('archived',false) == false
   && get(/databases/$(database)/documents/teams/$(request.resource.data.away)).data.get('archived',false) == false
   && request.resource.data.score == [0,0] && request.resource.data.sets == [] && request.resource.data.status == 'Agendada' && request.resource.data.notes == ''
   && pair(request.resource.data,'matches',id,null) && publishedMatch(request.resource.data,id))
   || (sportsAvailable() && restoreMatch(request.resource.data,id));
   allow update: if sportsAvailable() && stableSports(request.resource.data,resource.data) && operatorFor(id) && meta(request.resource.data,id) && request.resource.data._revision == resource.data._revision+1
    && pair(request.resource.data,'matches',id,resource.data) && publishedMatch(request.resource.data,id) && validMatchUpdate(request.resource.data,resource.data);
   allow delete: if cleanupAllowed(id,resource.data);
   allow update: if testClassify(request.resource.data,resource.data,id,'matches') && publishedMatch(request.resource.data,id);
  }
  match /publicSettings/main {
   allow read: if true;
   allow create, update: if admin() && request.resource.data == publicSettings(getAfter(/databases/$(database)/documents/settings/main).data);
   allow delete: if false;
  }
  match /publicTeams/{id} {
   allow read: if true;
   allow create, update: if activeSports(getAfter(/databases/$(database)/documents/teams/$(id)).data) && rosterManager() && request.resource.data == publicTeam(getAfter(/databases/$(database)/documents/teams/$(id)).data);
   allow delete: if owner() && getAfter(/databases/$(database)/documents/teams/$(id)).data.get('testData',false) == true;
  }
  function timelinePublicData(a,id) {
   let events = a.after.get('publicEvents',[]);
   let last = events.size() > 0 ? events[events.size()-1] : {};
   let athlete = last.get('id','') == id ? last : {};
   let e = a.detail;
   return {'id':id,'type':e.type,'side':e.side,'value':e.value,'stage':e.stage,
    'from':e.from,'to':e.to,'correctionOf':e.correctionOf,
    'playerName':athlete.get('playerName',''),'number':athlete.get('number',''),
    'at':a.at,'revision':a.revision};
  }
  match /publicMatches/{matchId}/timeline/{eventId} {
   allow read: if exists(/databases/$(database)/documents/publicMatches/$(matchId)) || operatorFor(matchId);
   allow create,update: if operatorFor(matchId)
    && getAfter(/databases/$(database)/documents/audit/$(eventId)).data.entity == 'matches'
    && getAfter(/databases/$(database)/documents/audit/$(eventId)).data.target == matchId
    && getAfter(/databases/$(database)/documents/audit/$(eventId)).data.detail.type in
      ['ponto','cartão amarelo','cartão vermelho','falta','substituição','tempo','status','etapa','set','acréscimos','cronômetro']
    && request.resource.data == timelinePublicData(
      getAfter(/databases/$(database)/documents/audit/$(eventId)).data,eventId);
   allow delete: if false;
  }
  // A projeção pública valida todos os campos; publishedMatch exige a mesma
  // revisão e horário do servidor, impedindo que a partida mude sem sua projeção.
  match /publicMatches/{id} {
   allow read: if true;
   allow create: if activeSports(getAfter(/databases/$(database)/documents/matches/$(id)).data) && matchCreator() && getAfter(/databases/$(database)/documents/matches/$(id)).data.get('publicHidden',false) == false && validPublicMatch(request.resource.data,getAfter(/databases/$(database)/documents/matches/$(id)).data);
   allow update: if activeSports(getAfter(/databases/$(database)/documents/matches/$(id)).data) && operatorFor(id) && getAfter(/databases/$(database)/documents/matches/$(id)).data.get('publicHidden',false) == false && validPublicMatch(request.resource.data,getAfter(/databases/$(database)/documents/matches/$(id)).data);
   allow delete: if (owner() && getAfter(/databases/$(database)/documents/matches/$(id)).data.get('testData',false) == true) || cleanupAllowed(id,get(/databases/$(database)/documents/matches/$(id)).data)
    || (owner() && get(/databases/$(database)/documents/matches/$(id)).data.get('publicHidden',false) == false
     && getAfter(/databases/$(database)/documents/matches/$(id)).data.get('publicHidden',false) == true);
  }
  match /audit/{id} {
   allow read: if admin();
   allow create: if staff() && request.resource.data.keys().hasOnly(['entity','target','actor','actorName','actorRole','at','revision','detail','before','after'])
    && bounded(request.resource.data.get('actorName',''),100)
    && request.resource.data.get('actorRole',owner() ? 'admin' : 'operator') == (owner() ? 'admin' : 'operator')
    && request.resource.data.entity in ['settings','teams','players','matches','championships'] && nonempty(request.resource.data.target,100)
    && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time && detailSchema(request.resource.data.detail)
    && request.resource.data.after == getAfter(/databases/$(database)/documents/$(request.resource.data.entity)/$(request.resource.data.target)).data
    && request.resource.data.after._audit == id && request.resource.data.after._updatedAt == request.time
    && request.resource.data.revision == request.resource.data.after._revision
    && request.resource.data.before == (exists(/databases/$(database)/documents/$(request.resource.data.entity)/$(request.resource.data.target)) ? get(/databases/$(database)/documents/$(request.resource.data.entity)/$(request.resource.data.target)).data : null);
  allow delete: if owner() && resource.data.entity == 'matches'
   && get(/databases/$(database)/documents/cleanupAudit/$(resource.data.target)).data.state == 'purgando';
  allow update: if false;
  }
  match /corrections/{id} {
   allow read: if admin();
   allow get: if operator() && (!exists(/databases/$(database)/documents/corrections/$(id))
    || operatorFor(resource.data.matchId));
   allow create: if operatorFor(request.resource.data.matchId) && historyCorrectionPermission() && request.resource.data.keys().hasOnly(['matchId','eventId','actionId','actor','at'])
    && request.resource.data.eventId == id && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
    && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.actionId)).data.detail.correctionOf == id
    && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data._audit == request.resource.data.actionId;
  allow update: if false;
  allow delete: if owner() && resource.data.matchId is string
   && get(/databases/$(database)/documents/cleanupAudit/$(resource.data.matchId)).data.state == 'purgando';
  }
  match /eventCredentials/{id} {
   allow read: if owner();
   allow create: if owner() && request.resource.data.keys().hasAll(['id','name','eventId','function','organization','validUntil','userId','status','issuedBy','issuedAt','updatedAt'])
    && request.resource.data.keys().hasOnly(['id','name','eventId','function','organization','validUntil','userId','status','issuedBy','issuedAt','updatedAt'])
    && request.resource.data.id == id && nonempty(request.resource.data.name,150) && nonempty(request.resource.data.function,80)
    && bounded(request.resource.data.organization,150) && request.resource.data.validUntil is string && request.resource.data.validUntil.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && bounded(request.resource.data.userId,128)
    && activeRef('championships',request.resource.data.eventId)
    && request.resource.data.status == 'ativa' && request.resource.data.issuedBy == request.auth.uid
    && request.resource.data.issuedAt == request.time && request.resource.data.updatedAt == request.time;
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status == 'revogada' && resource.data.status == 'ativa' && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Histórico operacional sem snapshots privados, e sem exclusão de lançamentos.
  function operationEventData(a,id) {
   let e = a.detail;
   let reason = e.correctionOf != '' ? e.reason : '';
   return {'id':id,'entity':'matches','target':a.target,'revision':a.revision,'at':a.at,
    'detail':{'type':e.type,'side':e.side,'value':e.value,'player':e.player,
     'stage':e.stage,'setIndex':e.setIndex,'correctionOf':e.correctionOf,
     'from':e.from,'to':e.to,'text':reason,'reason':reason}};
  }
  function validOperationEvent(matchId,eventId) {
   let a = getAfter(/databases/$(database)/documents/audit/$(eventId)).data;
   return a.entity == 'matches' && a.target == matchId
    && a.detail.type in ['ponto','cartão amarelo','cartão vermelho','falta','substituição','tempo','status','etapa','set','acréscimos','cronômetro']
    && request.resource.data == operationEventData(a,eventId);
  }
  match /matches/{matchId}/operationEvents/{eventId} {
   allow read: if operatorFor(matchId);
   allow create,update: if operatorFor(matchId) && validOperationEvent(matchId,eventId);
   allow delete: if false;
  }
  // Fichas: leitura pontual dos campeonatos atribuídos, sem edição ou listagem geral.
  match /championships/{id} {
   allow get: if owner() || (operator() && resource.data.get('testData',false) == false
    && ('championships' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions',[])
     || id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('operatedChampionships',[])));
  }
  // Identidade pública: consulta pontual dos logos, inclusive quando ainda não cadastrados.
  // Somente a conta principal grava neste documento.
  function brandingLogo(value) {
   return value is string && value.size() <= 40000
    && (value.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')
      || (value.size() <= 1500 && value.matches('(?i)https://[^\\s]+')));
  }
  function brandingImages(images) {
   let padded = images.concat(['','','','','','']);
   let joined = images.join('\n');
   let logo = '(data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+|(?i:https)://[^\\s]{1,1000}[^\\s]{0,492})';
   return images.size() <= 6
    && padded[0].size() <= 40000 && padded[1].size() <= 40000
    && padded[2].size() <= 40000 && padded[3].size() <= 40000
    && padded[4].size() <= 40000 && padded[5].size() <= 40000
    && (images.size() == 0 || (joined.split('\n').size() == images.size()
      && joined.matches(logo + '(\n' + logo + ')*')));
  }
  // The panel validates the layout values. Readers normalize them before rendering.
  function brandingLayout(d) {
   return d is map && d.size() == 9
    && d.keys().hasOnly(['system','school','organizers','sponsors','collaborators','watermarkText','opacity','size','angle']);
  }
  function brandingLayouts(d) {
   return d is map && d.size() == 7
    && brandingLayout(d.registration) && brandingLayout(d.credentials) && brandingLayout(d.certificates)
    && brandingLayout(d.matchSheets) && brandingLayout(d.reports) && brandingLayout(d.auditReports) && brandingLayout(d.publicPanel);
  }
  function brandingSchema(d) {
   return d.keys().hasOnly(['groups','surfaces','schoolLogo','layouts'])
    && d.groups is map && d.groups.keys().hasOnly(['0','1','2'])
    && brandingImages(d.groups['0']) && brandingImages(d.groups['1']) && brandingImages(d.groups['2'])
    && d.surfaces is list && d.surfaces.toSet().size()==d.surfaces.size()
    && d.surfaces.hasOnly(['registration','credentials','certificates','matchSheets','reports','auditReports','publicPanel'])
    && (d.get('schoolLogo','') == '' || brandingLogo(d.schoolLogo)) && (!('layouts' in d) || brandingLayouts(d.layouts));
  }
  match /publicBranding/partners {
   allow get: if true;
   allow create,update: if owner() && brandingSchema(request.resource.data);
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
